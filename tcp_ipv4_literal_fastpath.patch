+
+        sa4.sin_family = AF_INET;
+        sa4.sin_port   = htons(port);
+
+        inet_v4.ai_family   = AF_INET;
+        inet_v4.ai_socktype = SOCK_STREAM;
+        inet_v4.ai_protocol = IPPROTO_TCP;
+        inet_v4.ai_addr     = (struct sockaddr *)&sa4;
+        inet_v4.ai_addrlen  = sizeof(sa4);
+        inet_v4.ai_next     = NULL;
+
+        ai = &inet_v4;
+        is_ai_from_getaddrinfo = 0;
+        ret = 0;
+    } else {
         ret = getaddrinfo(hostname, portstr, &hints, &ai);
+        is_ai_from_getaddrinfo = 1;
+    }
+
