 static int tcp_open(URLContext *h, const char *uri, int flags)
 {
-    struct addrinfo hints = { 0 }, *ai, *cur_ai;
+    struct addrinfo hints = { 0 }, *ai = NULL, *cur_ai = NULL;
+
+    struct addrinfo inet_v4 = { 0 };
+    struct sockaddr_in sa4 = { 0 };
+    int is_ai_from_getaddrinfo = 1;
+
     int port, fd = -1;
     TCPContext *s = h->priv_data;
     const char *p;
@@ -148,10 +156,35 @@
     snprintf(portstr, sizeof(portstr), "%d", port);
     if (s->listen)
         hints.ai_flags |= AI_PASSIVE;
-    if (!hostname[0])
+
+    if (!hostname[0]) {
         ret = getaddrinfo(NULL, portstr, &hints, &ai);
-    else
+        is_ai_from_getaddrinfo = 1;
+    } else if (inet_pton(AF_INET, hostname, &sa4.sin_addr) == 1) {
+
+        // IPv4 리터럴 fast-path:
+        // iOS에서는 통신사/기지국 환경에 따라 getaddrinfo()가
+        // 로컬(RFC1918) IPv4 주소를 DNS64/NAT64 기반 IPv6 주소로
